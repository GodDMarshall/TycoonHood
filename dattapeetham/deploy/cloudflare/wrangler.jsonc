// Avadhoota Datta Peetham website: Cloudflare Workers static assets.
// Generated by tools/server-configs.mjs from deploy/routes.mjs (v1.0.0).
//
// Deploy from the project folder:  npx wrangler deploy --config deploy/cloudflare/wrangler.jsonc
// Use Workers, not Cloudflare Pages: Pages always redirects /about.html to
// /about, against the site's .html canonical URLs, and that cannot be turned
// off. Here html_handling "none" serves files exactly as named; _redirects
// and _headers in site/ supply the rest. Set the custom domain
// www.dattapeetham.org on the Worker, and enable "Always Use HTTPS" plus a
// redirect from dattapeetham.org in the zone.
{
  "name": "dattapeetham",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../site",
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
