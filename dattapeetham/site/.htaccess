# Avadhoota Datta Peetham website: Apache 2.4 (cPanel and most shared hosting).
# Generated by tools/server-configs.mjs from deploy/routes.mjs (v1.0.0).
# Do not edit by hand: change deploy/routes.mjs or site.config.json, then run
#   node tools/server-configs.mjs site
# (the build runs it too).
#
#   site:             https://www.dattapeetham.org
#   legacy platform:  https://www.dattapeetham.org  (same host: no platform redirects, they would loop)
#
# Needs AllowOverride All on the document root (cPanel default). Uses
# mod_rewrite, mod_headers, mod_mime, mod_dir; mod_deflate / mod_brotli when
# present. Every module block is guarded, so a missing module degrades a
# feature instead of breaking the site. deploy/apache/ has the server side.

DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

# No directory listings. No content negotiation: /about must redirect to
# /about.html, not quietly serve it.
Options -Indexes -MultiViews

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddCharset utf-8 .css .js .mjs .json .webmanifest .svg .xml .txt
</IfModule>

# ---- compression ---------------------------------------------------------
<IfModule mod_filter.c>
  <IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml text/plain
  </IfModule>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml text/plain
  </IfModule>
</IfModule>

# ---- caching -------------------------------------------------------------
# The Cache-Control headers below are the whole policy. A host-wide
# "ExpiresActive On" would add a second, conflicting max-age, so mod_expires
# is switched off for this site.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  Header always set Cache-Control "no-cache"
  <If "%{REQUEST_URI} =~ m#^/assets/.+\.(?:css|js|mjs)$#i">
    # versioned code
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/assets/.+\.(?:webp|avif|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|otf)$#i">
    # media
    Header always set Cache-Control "public, max-age=2592000"
  </ElseIf>

  # ---- security headers (every response, redirects and errors included) ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://dattapeetham.s3.amazonaws.com https://dev-dattapeetham.s3.amazonaws.com https://i.ytimg.com; frame-src https://www.youtube-nocookie.com https://www.google.com; connect-src 'self'; upgrade-insecure-requests"
  Header always unset X-Powered-By
</IfModule>

# ---- redirects -------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # mod_rewrite in .htaccess needs symlink following. If your host refuses
  # this line (500 error), delete it: most hosts already allow it.
  Options +SymLinksIfOwnerMatch

  # ==== BEGIN canonical host and HTTPS ========================================
  # Sends dattapeetham.org and plain http:// to https://www.dattapeetham.org.
  # Other host names (a staging or cPanel preview address, the server IP) are
  # left alone. To switch this block off, delete it, or add to the virtual
  # host:  SetEnvIf Request_URI "^" DP_CANONICAL=off
  # Behind a proxy or CDN that ends TLS, it trusts X-Forwarded-Proto: https.
  RewriteCond %{ENV:DP_CANONICAL} !=off
  RewriteCond %{REQUEST_URI} !^/\.well-known/(?:acme-challenge|pki-validation)/
  RewriteCond %{HTTP_HOST} ^dattapeetham\.org\.?(?::\d+)?$ [NC]
  RewriteRule ^ https://www.dattapeetham.org%{REQUEST_URI} [R=301,L]
  RewriteCond %{ENV:DP_CANONICAL} !=off
  RewriteCond %{REQUEST_URI} !^/\.well-known/(?:acme-challenge|pki-validation)/
  RewriteCond %{HTTP_HOST} ^www\.dattapeetham\.org\.?(?::\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://www.dattapeetham.org%{REQUEST_URI} [R=301,L]
  # ==== END canonical host and HTTPS ==========================================

  # Hidden files (except /.well-known/) and the other servers' config files.
  RewriteRule (?:^|/)\.(?!well-known(?:/|$)) - [R=404,L]
  RewriteRule ^(?:_headers|_redirects|web\.config)$ - [R=404,L]

  # Old-site URLs → new pages (301). The query string is kept; a #fragment
  # goes after it, so those rules come in pairs.
  RewriteRule ^sriswamiji$ /sri-swamiji.html [R=301,L]
  RewriteRule ^page/view/sri-swamiji$ /sri-swamiji.html [R=301,L]
  RewriteRule ^page/view/sri-ganapathy-sachchidananda-swamiji$ /sri-swamiji.html [R=301,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/sri-bala-swamiji$ /sri-swamiji.html#bala-swamiji [R=301,NE,L]
  RewriteRule ^page/view/sri-bala-swamiji$ /sri-swamiji.html?%{QUERY_STRING}#bala-swamiji [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/sri-swamijis-avatara-timeline$ /sri-swamiji.html#timeline [R=301,NE,L]
  RewriteRule ^page/view/sri-swamijis-avatara-timeline$ /sri-swamiji.html?%{QUERY_STRING}#timeline [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/awards-honors$ /sri-swamiji.html#honours [R=301,NE,L]
  RewriteRule ^page/view/awards-honors$ /sri-swamiji.html?%{QUERY_STRING}#honours [R=301,NE,L]
  RewriteRule ^page/view/datta-peetha-guru-parampara$ /guru-parampara.html [R=301,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/adi-guru-dattatreya$ /guru-parampara.html#dattatreya [R=301,NE,L]
  RewriteRule ^page/view/adi-guru-dattatreya$ /guru-parampara.html?%{QUERY_STRING}#dattatreya [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/datta-avadhoota$ /centers.html#kshetras [R=301,NE,L]
  RewriteRule ^page/view/datta-avadhoota$ /centers.html?%{QUERY_STRING}#kshetras [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/sri-jayalakshmi-maata$ /guru-parampara.html#jayalakshmi-maata [R=301,NE,L]
  RewriteRule ^page/view/sri-jayalakshmi-maata$ /guru-parampara.html?%{QUERY_STRING}#jayalakshmi-maata [R=301,NE,L]
  RewriteRule ^dattapeetham$ /about.html [R=301,L]
  RewriteRule ^page/view/about-us$ /about.html [R=301,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/ashram-life$ /about.html#ashram-life [R=301,NE,L]
  RewriteRule ^page/view/ashram-life$ /about.html?%{QUERY_STRING}#ashram-life [R=301,NE,L]
  RewriteRule ^page/view/ashram-shrines$ /darshan.html [R=301,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/kaalaagni-shamana-dattatreya$ /darshan.html#prayer-hall [R=301,NE,L]
  RewriteRule ^page/view/kaalaagni-shamana-dattatreya$ /darshan.html?%{QUERY_STRING}#prayer-hall [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/rajarajeshwari-temple$ /darshan.html#rajarajeshwari [R=301,NE,L]
  RewriteRule ^page/view/rajarajeshwari-temple$ /darshan.html?%{QUERY_STRING}#rajarajeshwari [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/sri-datta-venkateshwara-temple$ /darshan.html#venkateshwara [R=301,NE,L]
  RewriteRule ^page/view/sri-datta-venkateshwara-temple$ /darshan.html?%{QUERY_STRING}#venkateshwara [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/karya-siddhi-hanuman-temple$ /darshan.html#hanuman [R=301,NE,L]
  RewriteRule ^page/view/karya-siddhi-hanuman-temple$ /darshan.html?%{QUERY_STRING}#hanuman [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/shuka-vana$ /attractions.html#shuka-vana [R=301,NE,L]
  RewriteRule ^page/view/shuka-vana$ /attractions.html?%{QUERY_STRING}#shuka-vana [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/bonsai-garden$ /attractions.html#bonsai [R=301,NE,L]
  RewriteRule ^page/view/bonsai-garden$ /attractions.html?%{QUERY_STRING}#bonsai [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/vishwam-museum$ /attractions.html#vishwam [R=301,NE,L]
  RewriteRule ^page/view/vishwam-museum$ /attractions.html?%{QUERY_STRING}#vishwam [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/nada-mantapa$ /attractions.html#nada-mantapa [R=301,NE,L]
  RewriteRule ^page/view/nada-mantapa$ /attractions.html?%{QUERY_STRING}#nada-mantapa [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/sgs-hospital$ /seva.html#hospital [R=301,NE,L]
  RewriteRule ^page/view/sgs-hospital$ /seva.html?%{QUERY_STRING}#hospital [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/sgs-veda-pathashala$ /seva.html#pathashala [R=301,NE,L]
  RewriteRule ^page/view/sgs-veda-pathashala$ /seva.html?%{QUERY_STRING}#pathashala [R=301,NE,L]
  RewriteRule ^page/view/social-activities$ /seva.html [R=301,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/contribution-towards-nature$ /seva.html#nature [R=301,NE,L]
  RewriteRule ^page/view/contribution-towards-nature$ /seva.html?%{QUERY_STRING}#nature [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/sdhs-volunteers$ /seva.html#volunteer [R=301,NE,L]
  RewriteRule ^page/view/sdhs-volunteers$ /seva.html?%{QUERY_STRING}#volunteer [R=301,NE,L]
  RewriteRule ^page/view/bhajans-and-healing-music$ /music.html [R=301,L]
  RewriteRule ^page/view/datta-kriya-yoga$ /kriya-yoga.html [R=301,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/datta-kriya-yoga-international-center$ /kriya-yoga.html#dkyic [R=301,NE,L]
  RewriteRule ^page/view/datta-kriya-yoga-international-center$ /kriya-yoga.html?%{QUERY_STRING}#dkyic [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/guidelines-for-visitors$ /visit.html#guidelines [R=301,NE,L]
  RewriteRule ^page/view/guidelines-for-visitors$ /visit.html?%{QUERY_STRING}#guidelines [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/devotee-etiquette$ /visit.html#etiquette [R=301,NE,L]
  RewriteRule ^page/view/devotee-etiquette$ /visit.html?%{QUERY_STRING}#etiquette [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/datta-peetham-glossary$ /teachings.html#glossary [R=301,NE,L]
  RewriteRule ^page/view/datta-peetham-glossary$ /teachings.html?%{QUERY_STRING}#glossary [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/literary-contributions$ /teachings.html#literature [R=301,NE,L]
  RewriteRule ^page/view/literary-contributions$ /teachings.html?%{QUERY_STRING}#literature [R=301,NE,L]
  RewriteRule ^page/view/sanatana-dharma-parirakshana$ /teachings.html [R=301,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/ask-dattaji$ /teachings.html#ask-dattaji [R=301,NE,L]
  RewriteRule ^page/view/ask-dattaji$ /teachings.html?%{QUERY_STRING}#ask-dattaji [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/social-media-pages$ /media.html#social [R=301,NE,L]
  RewriteRule ^page/view/social-media-pages$ /media.html?%{QUERY_STRING}#social [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^page/view/dattapeetham-telecast-timing-of-sri-swamijis-programs$ /events.html#tv [R=301,NE,L]
  RewriteRule ^page/view/dattapeetham-telecast-timing-of-sri-swamijis-programs$ /events.html?%{QUERY_STRING}#tv [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^shodasha-datta-kshetras$ /centers.html#kshetras [R=301,NE,L]
  RewriteRule ^shodasha-datta-kshetras$ /centers.html?%{QUERY_STRING}#kshetras [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^navanatha-datta-kshetras$ /centers.html#navanatha [R=301,NE,L]
  RewriteRule ^navanatha-datta-kshetras$ /centers.html?%{QUERY_STRING}#navanatha [R=301,NE,L]
  RewriteCond %{QUERY_STRING} =""
  RewriteRule ^ashrams/avadhoota-datta-peetham-mysore-main$ /centers.html#mysuru [R=301,NE,L]
  RewriteRule ^ashrams/avadhoota-datta-peetham-mysore-main$ /centers.html?%{QUERY_STRING}#mysuru [R=301,NE,L]

  # Page URLs without .html → the canonical .html URL.
  RewriteRule ^((?:(?:kn|hi|ta|te)/)?)index$ /$1 [R=301,L]
  RewriteRule ^(kn|hi|ta|te)$ /$1/ [R=301,L]
  RewriteRule ^((?:(?:kn|hi|ta|te)/)?(?:about|attractions|centers|contact|darshan|events|guru-parampara|kriya-yoga|media|music|seva|sri-swamiji|teachings|visit))$ /$1.html [R=301,L]

  # Platform paths: none. The platform shares this host; see site.config.json.

  # A folder without an index page is "not found", not "forbidden".
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

# Without mod_rewrite, at least keep hidden files private.
<IfModule !mod_rewrite.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>
