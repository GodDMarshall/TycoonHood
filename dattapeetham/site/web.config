<?xml version="1.0" encoding="utf-8"?>
<!--
  Avadhoota Datta Peetham website: IIS 7.5+ (needs the URL Rewrite module).
  Generated by tools/server-configs.mjs from deploy/routes.mjs (v1.0.0).
  Do not edit by hand: change deploy/routes.mjs or site.config.json, then run
    node tools/server-configs.mjs site
  (the build runs it too).
  
    site:             https://www.dattapeetham.org
    legacy platform:  https://www.dattapeetham.org  (same host: no platform redirects, they would loop)
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
    <staticContent>
      <clientCache cacheControlMode="NoControl" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://dattapeetham.s3.amazonaws.com https://dev-dattapeetham.s3.amazonaws.com https://i.ytimg.com; frame-src https://www.youtube-nocookie.com https://www.google.com; connect-src 'self'; upgrade-insecure-requests" />
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-cache" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".htaccess" />
          <add segment=".assetsignore" />
          <add segment="_headers" />
          <add segment="_redirects" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <!-- ==== BEGIN canonical host and HTTPS: set enabled="false" on both rules to switch off ==== -->
        <rule name="DP canonical host" enabled="true" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^dattapeetham\.org\.?(?::\d+)?$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/(?:acme-challenge|pki-validation)/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.dattapeetham.org{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="DP https" enabled="true" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^www\.dattapeetham\.org\.?(?::\d+)?$" />
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_X_FORWARDED_PROTO}" pattern="^https$" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/(?:acme-challenge|pki-validation)/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.dattapeetham.org{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <!-- ==== END canonical host and HTTPS ==== -->
        <rule name="DP hidden files" stopProcessing="true">
          <match url="(?:^|/)\.(?!well-known(?:/|$))" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="DP old /sriswamiji" stopProcessing="true">
          <match url="^sriswamiji$" ignoreCase="false" />
          <action type="Redirect" url="/sri-swamiji.html" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="DP old /page/view/sri-swamiji" stopProcessing="true">
          <match url="^page/view/sri-swamiji$" ignoreCase="false" />
          <action type="Redirect" url="/sri-swamiji.html" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="DP old /page/view/sri-ganapathy-sachchidananda-swamiji" stopProcessing="true">
