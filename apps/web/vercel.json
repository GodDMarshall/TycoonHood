{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && bash scripts/vercel-build.sh",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": { "eco/*": false, "eco/**": false, "build/living-ecosystem": false }
  },
  "crons": [
    { "path": "/api/cron/expire-orders", "schedule": "0 0 * * *" },
    { "path": "/api/cron/email-holds", "schedule": "30 0 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
