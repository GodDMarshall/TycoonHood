# Ojasphera Labs — environment. Copy to .env.local for local development and
# uncomment only the lines you set. Every variable is optional.

# Canonical site URL (defaults to https://ojasphera.com)
# NEXT_PUBLIC_SITE_URL=https://ojasphera.com

# Public inbox shown in the footer and offered as an intake fallback
# NEXT_PUBLIC_CONTACT_EMAIL=

# Project-intake delivery — configure at least one in production
# INTAKE_WEBHOOK_URL=
# RESEND_API_KEY=
# INTAKE_TO_EMAIL=
# INTAKE_FROM_EMAIL=
