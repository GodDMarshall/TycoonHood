# ============================================================================
# TYCOONHOOD — environment
# Every variable the code actually reads is listed here. Anything marked
# OPTIONAL degrades honestly when absent (the feature reports that it is
# unconfigured — it never pretends to work).
# ============================================================================

# ─── REQUIRED ───────────────────────────────────────────────────────────────

# Postgres connection string.
# Local:  postgresql://tycoon:tycoon_dev@localhost:5432/tycoonhood_dev
# Neon:   postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/tycoonhood?sslmode=require
# NOTE: use the POOLED Neon URL for the app; the DIRECT URL for migrations.
DATABASE_URL=""

# Public origin of the main web app — absolute links in emails, certificate
# URLs, sitemap, OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public origin of the old standalone Miner app. It only forwards to /mining
# in the web app now (see apps/miner/lib/web-url.ts).
NEXT_PUBLIC_MINER_URL="http://localhost:3001"

# Public origin of the main site, read by the Miner app to link back.
NEXT_PUBLIC_MAIN_SITE_URL="http://localhost:3000"

# ─── ADMIN SEED (REQUIRED IN PRODUCTION) ────────────────────────────────────
# The seed creates exactly one admin. In production the seed REFUSES to run
# with the built-in development password — set both before seeding.
ADMIN_EMAIL="admin@tycoonhood.local"
ADMIN_PASSWORD=""
# The seed REFUSES the public built-in password on any database. For a
# throwaway LOCAL database only, set this to opt into it; never on a real one.
ALLOW_DEFAULT_ADMIN=""

# ─── SESSION SHARING (REQUIRED WHEN WEB + MINER SHARE A DOMAIN) ─────────────
# Registrable parent domain so one login covers both apps, e.g.
# ".tycoonhood.com" for www.tycoonhood.com + miner.tycoonhood.com.
# Leave EMPTY for localhost or unrelated domains.
COOKIE_DOMAIN=""

# ─── CLIENT ADDRESS (PER-IP LIMITS) ─────────────────────────────────────────
# How many proxies in front of the app add to X-Forwarded-For. The visitor's
# address is read that many entries from the right; entries further left are
# what the visitor sent and are ignored. 1 (the default) fits one proxy such
# as nginx, and Vercel, which replaces the header. Use 2 for a CDN in front of
# a proxy. An integer from 1 to 5; empty or anything else means 1.
# With no proxy in front (the app exposed directly), visitors can set the
# header themselves, so IP-based limits can be spoofed.
TRUSTED_PROXY_HOPS=""

# ─── OPTIONAL: EMAIL ────────────────────────────────────────────────────────
# Without these, password-reset links are printed to the server log and
# clearly labelled as development delivery. Nothing is silently dropped.
RESEND_API_KEY=""
MAIL_FROM=""

# ─── OPTIONAL: CARD PAYMENTS ────────────────────────────────────────────────
# Without these the card rail runs in development mode: orders are recorded
# and labelled uncharged, and the storefront says so on the product itself.
# THC checkout is unaffected and fully live.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── OPTIONAL: RAZORPAY (rupee checkout for the shop) ────────────────────────
# The cart checkout's rupee rail. Prices are stored in paise (INR).
# With BOTH key id and key secret set, checkout is LIVE: Razorpay Checkout.js
# opens in the browser and the server verifies the payment signature.
# Without them, and only when DEV_MODE="true" outside production, the rail runs
# a SANDBOX: payments are marked TEST, every screen says "Test mode — no real
# money is charged", and test orders are excluded from revenue. In production
# without keys the rupee rail is hidden; THC checkout still works.
# Dashboard → Settings → API Keys (rzp_live_… / rzp_test_…).
# Test keys (rzp_test_…) move no money: in production they offer card checkout
# to admins only, so members cannot take goods with a test card.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks → URL https://<your-domain>/api/webhooks/razorpay,
# events: payment.captured, order.paid, payment.failed, refund.processed.
# The secret you type there goes here. Enable automatic capture on the account.
RAZORPAY_WEBHOOK_SECRET=""

# ─── OPTIONAL: DISCORD ──────────────────────────────────────────────────────
# PUBLIC_KEY + APP_ID enable the slash-command endpoint (/link, /rank).
# BOT_TOKEN + GUILD_ID + ROLE_MAP enable rank-role syncing.
# Without them the integration is inert and reports exactly why.
DISCORD_PUBLIC_KEY=""
DISCORD_APP_ID=""
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
# JSON map of rank slug -> Discord role id
DISCORD_ROLE_MAP=""

# ─── DEVELOPMENT TOGGLES ────────────────────────────────────────────────────
DEV_MODE="true"
# PRISMA_LOG="query" to echo SQL.
PRISMA_LOG=""
# Escape hatch for the test-suite production guard. Never set this in CI
# against a database holding real members.
ALLOW_TESTS_ON_THIS_DB=""

# Affiliate programme: salt for visitor hashes (never store raw IPs). Any long random string.
AFFILIATE_HASH_SECRET=""
